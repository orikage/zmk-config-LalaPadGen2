#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define FOURTH_LAYER    3
#define SYSTEM_LAYER    4
#define CLIP_LAYER      5

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        /* クリスタモード切替: IMEオフ(INT5=無変換)を送ってからレイヤーをトグル。
           IMEオンのままだとクリスタの1文字ショートカット(P/E/[ など)が反応しないため */
        csp_toggle: csp_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings = <&macro_tap &kp INT5 &tog CLIP_LAYER>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <DEFAULT_LAYER SECONDARY_LAYER TERTIARY_LAYER FOURTH_LAYER SYSTEM_LAYER>; /* クリスタモードでは無効 */
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <DEFAULT_LAYER SECONDARY_LAYER TERTIARY_LAYER FOURTH_LAYER SYSTEM_LAYER>; /* クリスタモードでは無効 */
        };

        hankakku_zenkaku {
            bindings = <&kp LANG_ZENKAKUHANKAKU>;
            key-positions = <1 2>;
            layers = <DEFAULT_LAYER SECONDARY_LAYER TERTIARY_LAYER FOURTH_LAYER SYSTEM_LAYER>; /* クリスタモードでは無効 */
        };

        /* 左親指 Win+Alt 同時押し: クリスタモード(CLIP_LAYER)のON/OFF（同時にIMEオフ） */
        csp_mode_toggle {
            bindings = <&csp_toggle>;
            key-positions = <31 32>;
            layers = <DEFAULT_LAYER CLIP_LAYER>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W      &kp E         &kp R      &kp T                                     &kp Y      &kp U     &kp I        &kp O       &kp P
&kp A              &kp S      &kp D         &kp F      &kp G                                     &kp H      &kp J     &kp K        &kp L       &mt2 EQUAL MINUS
&mt2 LEFT_SHIFT Z  &kp X      &kp C         &kp V      &kp B                                     &kp N      &kp M     &kp COMMA    &kp PERIOD  &kp SLASH
&kp LCTRL          &kp LWIN   &kp LEFT_ALT  &mo 1      &kp SPACE  &kp LEFT_SHIFT  &kp BACKSPACE  &kp ENTER  &mo 2     &lt FOURTH_LAYER INT5   &kp INT4    &kp BACKSLASH
                   &none      &kp RIGHT     &kp DOWN   &kp LEFT   &kp UP          &kp UP         &kp LEFT   &kp DOWN  &kp RIGHT    &none
&mkp LCLK          &mkp RCLK  &mkp MCLK                                                                               &mkp LCLK    &mkp RCLK   &mkp MCLK
&mkp MB4           &mkp MB5   &kp LG(TAB)   &kp LG(D)  &kp LCTRL                                 &mkp MB4   &mkp MB5  &kp LG(TAB)  &kp LG(D)   &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp CAPSLOCK      &kp K_MUTE         &trans  &trans  &kp INSERT                      &kp PAGE_UP       &kp HOME           &kp UP_ARROW    &kp END    &kp PRINTSCREEN
&kp C_PLAY_PAUSE  &kp C_VOLUME_UP    &trans  &trans  &kp SCROLLLOCK                  &kp PAGE_DOWN     &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT  &kp LC(LS(TAB))
&trans            &kp C_VOLUME_DOWN  &trans  &trans  &kp DELETE                      &kp LC(T)         &mkp MB4           &kp LC(W)       &mkp MB5   &kp LC(F)
&trans            &trans             &trans  &trans  &trans          &trans  &trans  &trans            &trans             &trans          &trans     &trans
                  &trans             &trans  &trans  &trans          &trans  &trans  &trans            &trans             &trans          &trans
&trans            &trans             &trans                                                                               &trans          &trans     &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans  &trans  &trans                          &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans          &trans     &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp EXCLAMATION    &kp QUESTION  &kp SQT         &kp LEFT_BRACE        &kp RIGHT_BRACE                         &kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&kp COLON          &kp DOLLAR    &kp PIPE        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                   &trans          &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&kp DOUBLE_QUOTES  &kp TILDE     &kp UNDERSCORE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET                       &trans          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
&trans             &trans        &trans          &trans                &trans                 &trans  &kp DEL  &trans          &trans           &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_DIVIDE
                   &trans        &trans          &trans                &trans                 &trans  &trans   &trans          &trans           &trans           &trans
&trans             &trans        &trans                                                                                                         &trans           &trans           &trans
&trans             &trans        &trans          &trans                &trans                                  &trans          &trans           &trans           &trans           &trans
            >;
        };

        Fource {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6   &kp NUMBER_7      &kp NUMBER_8  &kp NUMBER_9   &kp NUMBER_0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5                        &kp F11        &kp F12           &kp COLON     &kp SEMICOLON  &kp ASTERISK
&kp F6        &kp F7        &kp F8        &kp F9        &kp F10                       &kp LESS_THAN  &kp GREATER_THAN  &trans        &trans         &trans
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans         &trans            &trans        &trans         &trans
              &trans        &trans        &trans        &trans        &trans  &trans  &trans         &trans            &trans        &trans
&trans        &trans        &trans                                                                                     &trans        &trans         &trans
&trans        &trans        &trans        &trans        &trans                        &trans         &trans            &trans        &trans         &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH          &kp PERCENT  &kp AMPERSAND                  &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp ASTERISK     &kp LESS_THAN  &kp GREATER_THAN  &kp PLUS     &kp GRAVE                      &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F13          &kp F14        &kp F15           &kp SEMI     &trans                         &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans           &trans         &trans            &trans       &trans         &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
                 &trans         &trans            &trans       &trans         &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans           &trans         &trans                                                                                                                      &trans                         &trans                         &trans
&trans           &trans         &trans            &trans       &trans                         &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };

        CLIP_LAYER {
            display-name = "clip_studio";
            /* よく使う操作ほど押しやすい位置（親指・ホーム段の人差し指/中指）に配置
               左右反転(Ctrl+Shift+Alt+H)はクリスタ側でショートカット登録が必要
               ブラシサイズはWindowsがJIS配列前提: JISでは RIGHT_BRACKET が「[」、NON_US_HASH が「]」になる */
            bindings = <
&kp LC(KP_MINUS)  &kp LC(KP_PLUS)  &kp RIGHT_BRACKET &kp NON_US_HASH    &kp LC(N0)                              &trans  &trans  &trans  &trans  &trans
&kp I             &kp C            &kp E             &kp P              &kp B                                   &trans  &trans  &trans  &trans  &trans
&kp M             &kp X            &kp K             &kp G              &kp LC(LS(LA(H)))                       &trans  &trans  &trans  &trans  &trans
&kp LCTRL         &kp LC(Y)        &kp LEFT_ALT      &kp LC(Z)          &kp SPACE          &kp LEFT_SHIFT  &trans   &trans  &trans  &trans  &trans  &trans
                  &trans           &kp LC(S)         &kp LC(D)          &kp DELETE         &kp LC(T)       &trans   &trans  &trans  &trans  &trans
&trans            &trans           &trans                                                                                           &trans  &trans  &trans
&trans            &trans           &trans            &trans             &trans                                  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <SECONDARY_LAYER TERTIARY_LAYER>;
            then-layer = <SYSTEM_LAYER>;
        };
    };
};
